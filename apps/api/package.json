{
  "name": "@renewal/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify 业务 API 与 Pi/保险公司基础设施适配器",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/bootstrap/migrate.ts",
    "dev": "tsx watch --env-file-if-exists=../../.env src/bootstrap/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/bootstrap/main.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@renewal/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "mysql2": "3.24.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
